#!/usr/bin/env python3
"""코스트코 코리아 공식 사이트에서 할인 상품을 모아 data.json으로 저장한다.

출처
  1) 매장 행사안내  https://www.costco.co.kr/events         (서버 렌더링)
  2) 온라인몰 스페셜 할인 / 바이어 추천 / 신상품            (브라우저 렌더링)

온라인몰은 자바스크립트로 목록을 그리므로 Playwright로 실제 브라우저를 띄운다.

수집에 실패하면 화면에서 읽은 텍스트 일부를 로그에 남긴다.
구조를 맞추려면 그 로그가 필요하다.
"""

import json
import re
import sys
from datetime import date, datetime, timedelta, timezone

from playwright.sync_api import sync_playwright

KST = timezone(timedelta(hours=9))
MIN_ITEMS = 25
DEBUG_LINES = 60

SOURCES = [
    ("스페셜 할인", "https://www.costco.co.kr/Special-Price-Offers/c/SpecialPriceOffers"),
    ("바이어 추천", "https://www.costco.co.kr/Buyers-Pick/c/BuyersPick"),
]
EVENTS_URL = "https://www.costco.co.kr/events"

PRICE_RE = re.compile(r"([0-9][0-9,]{2,})\s*원")
RATE_RE = re.compile(r"\b([1-9][0-9]?)\s*%")
DISCOUNT_RE = re.compile(r"([0-9][0-9,]{2,})\s*원\s*할인")


def clean(s: str) -> str:
    return re.sub(r"\s+", " ", s or "").strip()


def collect_tiles(page) -> list[str]:
    """상품 타일로 보이는 요소의 텍스트를 모은다.

    클래스명에 기대지 않는다. '원' 단위 가격을 가진 가장 작은 블록을 타일로 본다.
    """
    return page.evaluate(
        """
        () => {
          const hasPrice = t => /[0-9][0-9,]{2,}\\s*원/.test(t);
          const out = [];
          const all = document.querySelectorAll('li, article, div, a');
          for (const el of all) {
            const t = (el.innerText || '').trim();
            if (!t || t.length < 6 || t.length > 300) continue;
            if (!hasPrice(t)) continue;
            let childHasPrice = false;
            for (const c of el.querySelectorAll('li, article, div, a')) {
              const ct = (c.innerText || '').trim();
              if (ct && ct.length <= 300 && hasPrice(ct)) { childHasPrice = true; break; }
            }
            if (childHasPrice) continue;
            out.push(t);
          }
          return out;
        }
        """
    )


def parse_tiles(texts: list[str], category: str) -> list[dict]:
    items, seen = [], set()
    for raw in texts:
        text = clean(raw.replace("\n", " "))
        prices = [int(m.replace(",", "")) for m in PRICE_RE.findall(text)]
        if not prices:
            continue

        cut = [int(m.replace(",", "")) for m in DISCOUNT_RE.findall(text)]
        pool = [p for p in prices if p not in cut] or prices
        price = min(pool)
        if price < 500:
            continue

        rates = [int(m) for m in RATE_RE.findall(text) if int(m) <= 90]
        if rates:
            rate = max(rates)
        elif cut:
            base = price + max(cut)
            rate = round(max(cut) / base * 100)
        else:
            rate = 0

        name = PRICE_RE.sub(" ", text)
        name = RATE_RE.sub(" ", name)
        name = re.sub(r"할인|정상가|회원가|온라인가|배송비|무료|장바구니|바로구매", " ", name)
        name = clean(name)
        if len(name) < 3:
            continue

        key = (name, price)
        if key in seen:
            continue
        seen.add(key)
        items.append({"c": category, "n": name[:90], "p": price, "r": rate, "e": ""})
    return items


def scrape_listing(page, label: str, url: str) -> list[dict]:
    print(f"  {label} 접속: {url}")
    page.goto(url, wait_until="domcontentloaded", timeout=60000)
    try:
        page.wait_for_load_state("networkidle", timeout=30000)
    except Exception:
        pass
    page.wait_for_timeout(3000)

    # 무한 스크롤 / 더보기 대응
    for _ in range(12):
        before = page.evaluate("document.body.scrollHeight")
        page.mouse.wheel(0, 20000)
        page.wait_for_timeout(1500)
        for sel in ["text=더보기", "text=더 보기", "button:has-text('더보기')"]:
            try:
                btn = page.locator(sel).first
                if btn.is_visible(timeout=500):
                    btn.click(timeout=2000)
                    page.wait_for_timeout(1500)
            except Exception:
                pass
        if page.evaluate("document.body.scrollHeight") == before:
            break

    tiles = collect_tiles(page)
    items = parse_tiles(tiles, label)
    print(f"  {label}: 타일 {len(tiles)}개 → 상품 {len(items)}건")

    if not items:
        print(f"  --- {label} 화면 텍스트 (구조 확인용) ---")
        body = page.evaluate("document.body.innerText || ''")
        for line in [l for l in body.split("\n") if l.strip()][:DEBUG_LINES]:
            print(f"  | {line[:120]}")
        print(f"  --- 여기까지 ---")
    return items


def scrape_events(page, today: date) -> list[dict]:
    print(f"  매장 행사 접속: {EVENTS_URL}")
    page.goto(EVENTS_URL, wait_until="domcontentloaded", timeout=60000)
    page.wait_for_timeout(4000)
    body = page.evaluate("document.body.innerText || ''")

    end = ""
    m = re.search(r"(\d{1,2})\s*월\s*(\d{1,2})\s*일.{0,8}?~.{0,8}?(\d{1,2})\s*월\s*(\d{1,2})\s*일", body)
    if m:
        try:
            end = date(today.year, int(m.group(3)), int(m.group(4))).isoformat()
        except ValueError:
            end = ""

    items = []
    for line in body.split("\n"):
        line = clean(line)
        dm = DISCOUNT_RE.search(line)
        if not dm:
            continue
        cut = int(dm.group(1).replace(",", ""))
        name = clean(DISCOUNT_RE.sub(" ", line))
        name = re.sub(r"\b\d{6}\b|NO LIMIT|구매제한|수량", " ", name)
        name = clean(name)
        if len(name) < 3 or cut < 500:
            continue
        items.append({"c": "매장 행사", "n": name[:90], "p": 0, "r": 0, "e": end, "cut": cut})

    print(f"  매장 행사: {len(items)}건 (행사 종료일 {end or '미확인'})")
    if not items:
        print("  --- 매장 행사 화면 텍스트 (구조 확인용) ---")
        for line in [l for l in body.split("\n") if l.strip()][:DEBUG_LINES]:
            print(f"  | {line[:120]}")
        print("  --- 여기까지 ---")
    return items


def main() -> int:
    today = datetime.now(KST).date()
    print(f"수집 시작 — 기준일 {today}")
    all_items = []

    with sync_playwright() as p:
        browser = p.chromium.launch(args=["--disable-blink-features=AutomationControlled"])
        ctx = browser.new_context(
            locale="ko-KR",
            viewport={"width": 1440, "height": 1000},
            user_agent=(
                "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 "
                "(KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
            ),
        )
        page = ctx.new_page()

        for label, url in SOURCES:
            try:
                all_items.extend(scrape_listing(page, label, url))
            except Exception as e:                     # noqa: BLE001
                print(f"  {label} 실패: {e}", file=sys.stderr)

        try:
            all_items.extend(scrape_events(page, today))
        except Exception as e:                         # noqa: BLE001
            print(f"  매장 행사 실패: {e}", file=sys.stderr)

        browser.close()

    seen, merged = set(), []
    for it in all_items:
        key = (it["n"], it["p"])
        if key in seen:
            continue
        seen.add(key)
        merged.append(it)

    print(f"총 {len(merged)}건")
    if len(merged) < MIN_ITEMS:
        print(
            f"수집 실패: {len(merged)}건은 하한({MIN_ITEMS})보다 적습니다.\n"
            "위에 찍힌 '화면 텍스트'를 보고 추출 규칙을 맞춰야 합니다.",
            file=sys.stderr,
        )
        return 1

    merged.sort(key=lambda x: (-x["r"], x["p"]))
    payload = {
        "generated": datetime.now(KST).isoformat(timespec="seconds"),
        "today": today.isoformat(),
        "count": len(merged),
        "items": merged,
    }
    with open("data.json", "w", encoding="utf-8") as f:
        json.dump(payload, f, ensure_ascii=False, separators=(",", ":"))
    print("data.json 저장 완료")
    return 0


if __name__ == "__main__":
    sys.exit(main())
